@model ConfigurationModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="EnableUSPSMethod" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="EnableUSPSMethod" />
            <span asp-validation-for="EnableUSPSMethod"></span>
        </div>
    </div>
    <nop-nested-setting asp-for="EnableUSPSMethod">
        <div class="form-group row" id="pnlUSPSTrackingApiUrl">
            <div class="col-md-3">
                <nop-label asp-for="USPSTrackingApiUrl" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="USPSTrackingApiUrl" />
                <span asp-validation-for="USPSTrackingApiUrl"></span>
            </div>
        </div>
        <div class="form-group row" id="pnlUSPSUsername">
            <div class="col-md-3">
                <nop-label asp-for="USPSUsername" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="USPSUsername" />
                <span asp-validation-for="USPSUsername"></span>
            </div>
        </div>
        <div class="form-group row" id="pnlUSPSPassword">
            <div class="col-md-3">
                <nop-label asp-for="USPSPassword" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="USPSPassword" />
                <span asp-validation-for="USPSPassword"></span>
            </div>
        </div>
    </nop-nested-setting>
</div>
<script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.EnableUSPSMethod)").click(toggleUSPSMethods);

        toggleUSPSMethods();
    });

    function toggleUSPSMethods() {
        if ($('#@Html.IdFor(model => model.EnableUSPSMethod)').is(':checked')) {
            $('#pnlUSPSTrackingApiUrl').showElement();
            $('#pnlUSPSUsername').showElement();
            $('#pnlUSPSPassword').showElement();
        } else {
            $('#pnlUSPSTrackingApiUrl').hideElement();
            $('#pnlUSPSUsername').hideElement();
            $('#pnlUSPSPassword').hideElement();
        }
    }
</script>
@model ModelProductModel

@if (Model.Id > 0)
{
    <div class="card-body">
        @await Html.PartialAsync("Table", new DataTablesModel
        {
            Name = "products-grid",
            UrlRead = new DataUrl("ModelProductList", "MakeTypeModel", new RouteValueDictionary { [nameof(Model.ModelProductMappingSearchModel.ModelId)] = Model.ModelProductMappingSearchModel.ModelId }),
            UrlDelete = new DataUrl("ModelProductDelete", "MakeTypeModel", null),
            Length = Model.ModelProductMappingSearchModel.PageSize,
            LengthMenu = Model.ModelProductMappingSearchModel.AvailablePageSizes,
            ColumnCollection = new List<ColumnProperty>
                {
                    new ColumnProperty(nameof(ModelProductMappingModel.ProductName))
                    {
                        Title = T("Plugins.Widgets.MakeTypeModel.ModelProductMapping.Fields.Product").Text
                    },
                    new ColumnProperty(nameof(ModelProductMappingModel.ProductId))
                    {
                        Title = T("Admin.Common.View").Text,
                        Width = "150",
                        ClassName = NopColumnClassDefaults.Button,
                        Render = new RenderButtonView(new DataUrl("~/Admin/Product/Edit/", nameof(ModelProductMappingModel.ProductId)))
                    },
                    new ColumnProperty(nameof(ModelProductMappingModel.Id))
                    {
                        Title = T("Admin.Common.Delete").Text,
                        Width = "100",
                        Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                        ClassName = NopColumnClassDefaults.Button
                    }
                }
        })
    </div>
    <div class="card-footer">
        <button type="submit" id="btnAddNewProduct"
                onclick="javascript:OpenWindow('@(Url.Action("ModelProductAddPopup", "MakeTypeModel", new { modelId = Model.Id, btnId = "btnRefreshProducts", formId = "model-form" }))', 800, 800, true); return false;"
                class="btn btn-primary">
            @T("Plugins.Widgets.MakeTypeModel.ModelProductMapping.Fields.Product.AddNew")
        </button>
        <button type="submit" id="btnRefreshProducts" style="display: none"></button>
        <script>
            $(document).ready(function () {
                $('#btnRefreshProducts').click(function () {
                    //refresh grid
                    updateTable('#products-grid');

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    </div>
}
else
{
    <div class="card-body">
        @T("Plugins.Widgets.MakeTypeModel.ModelProductMapping.Fields.Product.SaveBeforeEdit")
    </div>
}


@model ModelCategorySearchModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Widgets.MakeTypeModel.ModelCategories").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(MakeTypeModelDefaults.ModelCategory);
}

@{
    const string hideSearchBlockAttributeName = "ModelCategories.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}
<form asp-controller="MakeTypeModel" asp-action="CategoryList" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Widgets.MakeTypeModel.ModelCategories")
        </h1>
        <div class="float-right">
            <button asp-action="CategorySync" type="submit" name="model-categories-sync" class="btn bg-olive">
                <i class="fas fa-sync-alt"></i>
                @T("Plugins.Widgets.MakeTypeModel.ModelCategorySync")
            </button>
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>

                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchCategoryName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchCategoryName" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="text-center col-12">
                                        <button type="button" id="search-categories" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                                Name = "categories-grid",
                                UrlRead = new DataUrl("CategoryList", "MakeTypeModel", null),
                                UrlUpdate = new DataUrl("ModelCategoryUpdate", "MakeTypeModel", null),
                                SearchButtonId = "search-categories",
                                Length = Model.PageSize,
                                LengthMenu = Model.AvailablePageSizes,
                                Filters = new List<FilterParameter>
                                {
                                    new FilterParameter(nameof(Model.SearchCategoryName))
                                },
                                ColumnCollection = new List<ColumnProperty>
                                {
                                    new ColumnProperty(nameof(ModelCategoryModel.CategoryName))
                                    {
                                        Title = T("Admin.Catalog.Categories.Fields.Name").Text,
                                        Width = "500",
                                        Editable = false,
                                        EditType = EditType.String
                                    },
                                    new ColumnProperty(nameof(ModelCategoryModel.Published))
                                    {
                                        Title = T("Admin.Catalog.Categories.Fields.Published").Text,
                                        Width = "50",
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Render = new RenderBoolean(),
                                        Editable = true,
                                        EditType = EditType.Checkbox
                                    },
                                    new ColumnProperty(nameof(ModelCategoryModel.DisplayOrder))
                                    {
                                        Title = T("Admin.Catalog.Categories.Fields.DisplayOrder").Text,
                                        Width = "50",
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Editable = true,
                                        EditType = EditType.Number
                                    },
                                    new ColumnProperty(nameof(ModelCategoryModel.Id))
                                    {
                                        Title = T("Admin.Common.Edit").Text,
                                        Width = "50",
                                        ClassName =  NopColumnClassDefaults.Button,
                                        Render = new RenderButtonsInlineEdit()
                                    },
                                    new ColumnProperty(nameof(ModelCategoryModel.Id))
                                    {
                                        Title = T("Admin.Common.View").Text,
                                        Width = "50",
                                        ClassName = NopColumnClassDefaults.Button,
                                        Render = new RenderButtonView(new DataUrl("~/Admin/Category/Edit/", nameof(ModelCategoryModel.CategoryId)))
                                    }
                                }
                            })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
@model FoxNetSoft.Plugin.Misc.StampsConnector.Models.ShippingLabelModel
@{
    Layout = "_AdminLayout";
    //page title
    ViewBag.PageTitle = @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.ShippingLabel").Text;

    NopHtml.SetActiveMenuItemSystemName("Orders");
}
<form asp-controller="StampsAdmin" asp-action="ShippingLabel" asp-route-orderId="@Model.OrderId" asp-route-shipmentId="@Model.ShipmentId" method="post" id="stampsconnector-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.ShippingLabel")
            <small>
                <i class="fa fa-arrow-circle-left"></i>
                <a asp-controller="Order" asp-action="Edit" asp-route-id="@Model.OrderId">@T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.BackToOrder") #@(Model.OrderId)</a>
                @if (Model.ShipmentId > 0)
                {
                    <i class="fa fa-arrow-circle-left"></i>
                    <a asp-controller="Order" asp-action="ShipmentDetails" asp-route-id="@Model.ShipmentId">@T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.BackToShipment") #@(Model.ShipmentId)</a>
                }
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.CreateLabel")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/FoxNetSoft.StampsConnector/Views/CreateLabel/_CreateOrUpdate.cshtml", Model)
</form>


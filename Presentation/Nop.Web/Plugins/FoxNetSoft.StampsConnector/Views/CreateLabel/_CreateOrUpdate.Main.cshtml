@model FoxNetSoft.Plugin.Misc.StampsConnector.Models.CommonLabelModel
@using FoxNetSoft.Plugin.Misc.StampsConnector.Models
@{
    var isReturnLabel = Model is ReturnLabelModel;
    var hideCahOnDelivery = true;
}
<script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.EnableCashOnDelivery)").click(toggleEnableCashOnDelivery);

        toggleEnableCashOnDelivery();
    });

    function toggleEnableCashOnDelivery() {
        if ($('#@Html.IdFor(model => model.EnableCashOnDelivery)').is(':checked')) {
            $('#pnlCashOnDeliveryAmount').showElement();
        } else {
            $('#pnlCashOnDeliveryAmount').hideElement();
        }
    }
</script>
<div class="card-body">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="CarrierService" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="CarrierService" asp-items="Model.AvailableCarrierServices" />
                        <span asp-validation-for="CarrierService"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="PackagingType" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="PackagingType" asp-items="Model.AvailablePackagingTypes" />
                        <span asp-validation-for="PackagingType"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EnableDeliveryConfirmation" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="EnableDeliveryConfirmation" />
                        <span asp-validation-for="EnableDeliveryConfirmation"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EnableSignatureConfirmation" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="EnableSignatureConfirmation" />
                        <span asp-validation-for="EnableSignatureConfirmation"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="InsurePackage" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="InsurePackage" />
                        <span asp-validation-for="InsurePackage"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="HideThePostageAmount" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="HideThePostageAmount" />
                        <span asp-validation-for="HideThePostageAmount"></span>
                    </div>
                </div>
                <div class="form-group row" @(hideCahOnDelivery ? Html.Raw("style=\"display:none\"") : null)>
                    <div class="col-md-3">
                        <nop-label asp-for="EnableCashOnDelivery" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="EnableCashOnDelivery" />
                        <span asp-validation-for="EnableCashOnDelivery"></span>
                    </div>
                </div>
                <nop-nested-setting asp-for="EnableCashOnDelivery">
                    <div class="form-group row" id="pnlCashOnDeliveryAmount" @(hideCahOnDelivery ? Html.Raw("style=\"display:none\"") : null)>
                        <div class="col-md-3">
                            <nop-label asp-for="CashOnDeliveryAmount" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="CashOnDeliveryAmount" />
                            <span asp-validation-for="CashOnDeliveryAmount"></span>
                        </div>
                    </div>
                </nop-nested-setting>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ShippingDescription" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ShippingDescription" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-body">
                <div class="card-header">
                    @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.Main.Packages.Caption")
                </div>
                <div class="form-group row">
                    <div class="col-md-12" style="overflow-x: auto;">
                        <table class="table table-hover table-bordered text-center" id="packages_table">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.PackageModel.Weight") (@(Model.BaseWeightIn))
                                    </th>
                                    <th style="width: 20%;">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.PackageModel.Height") (@(Model.BaseDimensionIn))
                                    </th>
                                    <th style="width: 20%;">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.PackageModel.Length") (@(Model.BaseDimensionIn))
                                    </th>
                                    <th style="width: 20%;">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.PackageModel.Width") (@(Model.BaseDimensionIn))
                                    </th>
                                    <th style="width: 20%;">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.PackageModel.InsuranceAmount") (@(Model.PrimaryStoreCurrencyCode))
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Packages.Count; i++)
                                {
                                    <tr id="packadge_@(i)">
                                        <td style="width: 20%;">
                                            <input id="packadge_weight_@(i)" name="packadge_weight_@(i)" type="number" value="@Model.Packages[i].Weight" class="form-control" />
                                        </td>
                                        <td style="width: 20%;">
                                            <input id="packadge_height_@(i)" name="packadge_height_@(i)" type="number" value="@Model.Packages[i].Height" class="form-control" />
                                        </td>
                                        <td style="width: 20%;">
                                            <input id="packadge_length_@(i)" name="packadge_length_@(i)" type="number" value="@Model.Packages[i].Length" class="form-control" />
                                        </td>
                                        <td style="width: 20%;">
                                            <input id="packadge_width_@(i)" name="packadge_width_@(i)" type="number" value="@Model.Packages[i].Width" class="form-control" />
                                        </td>
                                        <td style="width: 20%;">
                                            <input id="packadge_insuranceamount_@(i)" name="packadge_insuranceamount_@(i)" type="number" value="@Model.Packages[i].InsuranceAmount" class="form-control" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-body">
                <div class="card-header">
                    @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.Main.ShippingRates.Caption")
                </div>
                <div class="form-group row">
                    <div class="col-md-12" style="overflow-x: auto;">
                        <table class="table table-hover table-bordered text-center">
                            <thead>
                                <tr>
                                    <th style="width: 500px;">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.ShippingRate.Name")
                                    </th>
                                    <th style="width: 60px">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.ShippingRate.Rate")
                                    </th>
                                    <th style="width: 120px">
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.ShippingRate.TransitDays")
                                    </th>
                                    <th>
                                        @T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.ShippingRate.Description")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var shippingRate in Model.ShippingRates)
                                {
                                    <tr>
                                        <td style="width: 250px;">
                                            @shippingRate.Name
                                        </td>
                                        <td style="width: 60px">
                                            @shippingRate.Rate
                                        </td>
                                        <td style="width: 120px">
                                            @shippingRate.TransitDays
                                        </td>
                                        <td>
                                            @shippingRate.Description
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="requirement-data-buttons">
                            <button type="submit" id="btnUpdateRates" name="btnUpdateRates" class="btn btn-primary">@T("Admin.FoxNetSoft.Plugin.Misc.StampsConnector.Main.ShippingRate.Button.CalculateRates")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


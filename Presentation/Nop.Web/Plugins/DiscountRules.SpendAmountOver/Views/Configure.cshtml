@model RequirementModel
@{
    Layout = "";
}

<script>
    $(function () {
        $('#savespendamountoverrequirement@(Model.RequirementId)').click(function () {
            var spendAmount = $("#@Html.IdFor(model => model.SpendAmount)").val();
            var vendorIds = $("#@Html.IdFor(model => model.SelectedVendorIds)").val();

            var discountId = @Model.DiscountId;
            var requirementId = @Model.RequirementId;

            var postData = {
                DiscountId: discountId,
                RequirementId: requirementId,
                SpendAmount: spendAmount,
                SelectedVendorIds: vendorIds
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache:false,
                type: "POST",
                url: "@(Url.Action("Configure", "DiscountRulesSpentAmountOver"))",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    
                    var $alertInfoEl = $("#savespendamountoverrequirementAlert-info");
                    let response = jqXHR.responseJSON;
                    if (response instanceof Object && response.hasOwnProperty('Errors')) {
                        var errorMessages = '';
                        $.each(response.Errors, function (i, error) {
                            errorMessages += error;
                            if (response.Errors.length - 1 != i)
                                errorMessages += '</br>';
                        });
                        $alertInfoEl.html(errorMessages);
                        $("#savespendamountoverrequirementAlert").click();

                        return;
                    }

                    $('#pnl-save-requirement-result@(Model.RequirementId)').fadeIn("slow").delay(1000).fadeOut("slow");
                    //notify parent if it's a new requirement
                    @if (Model.RequirementId == 0)
                    {
                        <text>$("#discountRequirementContainer").trigger('nopnewdiscountruleadded', [data.NewRequirementId]); </text>
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    var $alertInfoEl = $("#savespendamountoverrequirementAlert-info");

                    // display default error
                    $alertInfoEl.html('@T("Admin.Promotions.Discounts.Requirements.FailedToSave")');

                    $("#savespendamountoverrequirementAlert").click();
                }
            });
        });
    });
</script>

<div class="form-group row">
    <div class="col-md-3 requirement-label-col">
        <nop-label asp-for="SpendAmount" />
    </div>
    <div class="col-md-9 requirement-data-col">
        <div class="requirement-data-input">
            <nop-editor asp-for="SpendAmount" />
        </div>
    </div>
</div>
<div class="form-group row">
    <div class="col-md-3 requirement-label-col">
        <nop-label asp-for="SelectedVendorIds" />
    </div>
    <div class="col-md-9 requirement-data-col">
        <div class="requirement-data-input">
            <nop-select asp-for="SelectedVendorIds" asp-items="Model.AvailableVendors" asp-multiple="true" />
            <script>
                $(function () {
                    var vendorIdsInput = $('#@Html.IdFor(model => model.SelectedVendorIds)').select2({
                        closeOnSelect: false,
                        @if (Model.AvailableVendors.Count == 0)
                        {
                            <text>
                                disabled: true,
                                placeholder: '@T("Plugins.DiscountRules.SpendAmountOver.Fields.Vendors.NoVendors")',
                            </text>
                        }
                    });
                });
            </script>
        </div>
    </div>
</div>
<div class="form-group row">
    <div class="offset-md-3 col-md-9">
        <div class="requirement-data-buttons">
            <button type="button" id="savespendamountoverrequirement@(Model.RequirementId)" class="btn btn-primary">@T("Admin.Common.Save")</button>
        </div>
    </div>
</div>
<div class="form-group row">
    <div class="offset-md-3 col-md-9 requirement-messages-col">
        <div id="pnl-save-requirement-result@(Model.RequirementId)" style="display: none;" class="text-green margin-t-5">
            @T("Admin.Promotions.Discounts.Requirements.Saved")
        </div>
    </div>
</div>
<nop-alert asp-alert-id="savespendamountoverrequirementAlert" />
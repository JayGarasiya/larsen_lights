@model ChartsAndTablesSearchModel
@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Reports.ChartsAndTables.Customers").Text;

    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Plugins.Reports.ChartsAndTables.Customers");

    if(Model.CustomerReport)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/chart.js/chart.umd.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/buttons.html5.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/report.chart.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/jszip.min.js", excludeFromBundle: true);
    }
}

@{
    const string hideSearchBlockAttributeName = "ReportsCustomerMenu.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    const string hideCustomerBlockAttributeName = "ReportsCustomerMenu.HideCustomerBlock";
    var hideCustomerBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCustomerBlockAttributeName);

    const string hideRegisteredCustomerBlockAttributeName = "ReportsCustomerMenu.HideRegisteredCustomerBlock";
    var hideRegisteredCustomerBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideRegisteredCustomerBlockAttributeName, defaultValue: true);

    const string hideGenderBlockAttributeName = "ReportsCustomerMenu.HideGenderBlock";
    var hideGenderBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideGenderBlockAttributeName, defaultValue: true);

    const string hideCustomerRolesBlockAttributeName = "ReportsCustomerMenu.HideCustomerRolesBlock";
    var hideCustomerRolesBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCustomerRolesBlockAttributeName, defaultValue: true);

    const string hideCountryBlockAttributeName = "ReportsCustomerMenu.HideCountryBlock";
    var hideCountryBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCountryBlockAttributeName, defaultValue: true);
 }

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Reports.ChartsAndTables.Customers")
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            @if (Model.CustomerReport)
            {
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>

                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="StartDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="StartDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="EndDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="EndDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchGroupId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="SearchGroupId" asp-items="Model.GroupByOptions" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="RoleId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="RoleId" asp-items="Model.AvailableRoles" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="form-group row" @(Model.AvailableStores.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="StoreId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" />
                                            </div>
                                        </div>
                                        <div class="form-group row" @(Model.IsLoggedInAsVendor ? Html.Raw("style='display: none;'") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="OrderStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="OrderStatusId" asp-items="Model.AvailableOrderStatuses" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="PaymentStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="CountryId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="CountryId" asp-items="Model.AvailableCountries" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="text-center col-12">
                                        <button type="button" id="btnGenerate" class="btn btn-primary btn-search">
                                            <i class="fas fa-chart-line"></i>
                                            @T("Plugins.Reports.ChartsAndTables.Generate")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <nop-cards id="reports-menu-customers-cards">
                    @if (Model.CustomerMenuCustomerReport)
                    {
                        <nop-card asp-name="customers-report" asp-icon="far fa-user" asp-title="@T("Plugins.Reports.ChartsAndTables.Customers.Menu.Customer")" asp-hide-block-attribute-name="@hideCustomerBlockAttributeName" asp-hide="@hideCustomerBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Customer/_CustomersMenuReport.Customers.cshtml", Model)</nop-card>
                    }
                    @if (Model.CustomerMenuRegisteredCustomerReport)
                    {
                        <nop-card asp-name="customers-registered-report" asp-icon="far fa-registered" asp-title="@T("Plugins.Reports.ChartsAndTables.Customers.Menu.RegisteredCustomer")" asp-hide-block-attribute-name="@hideRegisteredCustomerBlockAttributeName" asp-hide="@hideRegisteredCustomerBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Customer/_CustomersMenuReport.RegisteredCustomer.cshtml", Model)</nop-card>
                    }
                    @if (Model.CustomerMenuGenderReport)
                    {
                        <nop-card asp-name="customers-gender-report" asp-icon="fas fa-mars-double" asp-title="@T("Plugins.Reports.ChartsAndTables.Customers.Menu.CustomerGender")" asp-hide-block-attribute-name="@hideGenderBlockAttributeName" asp-hide="@hideGenderBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Customer/_CustomersMenuReport.Gender.cshtml", Model)</nop-card>
                    }
                    @if (Model.CustomerMenuCustomerRolesReport)
                    {
                        <nop-card asp-name="customers-role-report" asp-icon="fas fa-code-branch" asp-title="@T("Plugins.Reports.ChartsAndTables.Customers.Menu.CustomerRoles")" asp-hide-block-attribute-name="@hideCustomerRolesBlockAttributeName" asp-hide="@hideCustomerRolesBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Customer/_CustomersMenuReport.CustomerRoles.cshtml", Model)</nop-card>
                    }
                    @if (Model.CustomerMenuCountryReport)
                    {
                        <nop-card asp-name="customers-country-report" asp-icon="fas fa-globe-europe" asp-title="@T("Plugins.Reports.ChartsAndTables.Customers.Menu.Country")" asp-hide-block-attribute-name="@hideCountryBlockAttributeName" asp-hide="@hideCountryBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Customer/_CustomersMenuReport.Country.cshtml", Model)</nop-card>
                    }
                </nop-cards>
            }
            else
            {
                @T("Plugins.Reports.ChartsAndTables.Customers.Menu.None")
            }
        </div>
    </div>
</section>
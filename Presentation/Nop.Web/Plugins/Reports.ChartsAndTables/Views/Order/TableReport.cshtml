@model ChartsAndTablesSearchModel
@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Reports.ChartsAndTables.Table").Text;

    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Plugins.Reports.ChartsAndTables.Table");

    if (Model.TableReport)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/buttons.html5.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/jszip.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/report.chart.js", excludeFromBundle: true);
    }
}

@{
    const string hideSearchBlockAttributeName = "ReportsTableMenu.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Reports.ChartsAndTables.Table")
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            @if (Model.TableReport)
            {
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>

                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="StartDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="StartDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="EndDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="EndDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row" @(Model.IsLoggedInAsVendor? Html.Raw("style='display: none;'") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="OrderStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="OrderStatusId" asp-items="Model.AvailableOrderStatuses" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="PaymentStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-md-5">
                                        <div class="form-group row" @(Model.AvailableStores.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="StoreId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="CategoryId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="CategoryId" asp-items="Model.AvailableCategories" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="ManufacturerId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="ManufacturerId" asp-items="Model.AvailableManufacturers" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="VendorId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="VendorId" asp-items="Model.AvailableVendors" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="text-center col-12">
                                        <button type="button" id="btnGenerate" class="btn btn-primary btn-search">
                                            <i class="fas fa-chart-line"></i>
                                            @T("Plugins.Reports.ChartsAndTables.Generate")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">

                        <div class="card-body">
                            <div class="mb-1">
                                <div id="tablereport"></div>
                            </div>
                            @{
                                var gridModel = new DataTablesModel
                                {
                                    Name = "tablereport-grid",
                                    UrlRead = new DataUrl("ReportMenuTableList", "ChartsAndTablesMenu", null),
                                    SearchButtonId = "btnGenerate",
                                    Length = Model.PageSize,
                                    LengthMenu = Model.AvailablePageSizes,
                                    FooterCallback = "tablereportfootercallback",
                                    FooterColumns = 12,
                                    DrawCallback = "tablereport",
                                    Filters = new List<FilterParameter>
                                                {
                                                new FilterParameter(nameof(Model.StartDate), typeof(DateTime?)),
                                                new FilterParameter(nameof(Model.EndDate), typeof(DateTime?)),
                                                new FilterParameter(nameof(Model.OrderStatusId)),
                                                new FilterParameter(nameof(Model.PaymentStatusId)),
                                                new FilterParameter(nameof(Model.StoreId)),
                                                new FilterParameter(nameof(Model.CategoryId)),
                                                new FilterParameter(nameof(Model.ManufacturerId)),
                                                new FilterParameter(nameof(Model.VendorId))
                                                },
                                    ColumnCollection = new List<ColumnProperty>
                                                {
                                                new ColumnProperty(nameof(TableReportModel.OrderId))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.OrderId").Text,
                                                Visible = false,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.CustomerEmail))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.CustomerId").Text,
                                                Width = "150",
                                                Visible = false,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.ProductName))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.ProductId").Text,
                                                Width = "300",
                                                Encode = false,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.Sku))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.Sku").Text,
                                                Width = "100",
                                                ClassName =  NopColumnClassDefaults.CenterAll,
                                                Visible = false,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.PaymentMethod))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.PaymentMethod").Text,
                                                Width = "100",
                                                ClassName =  NopColumnClassDefaults.CenterAll,
                                                Visible = false,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.ShippingMethod))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.ShippingMethod").Text,
                                                Width = "100",
                                                ClassName =  NopColumnClassDefaults.CenterAll,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.BillingCountry))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.BillingCountry").Text,
                                                Width = "50",
                                                ClassName =  NopColumnClassDefaults.CenterAll,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.BillingCity))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.BillingCity").Text,
                                                Width = "50",
                                                ClassName =  NopColumnClassDefaults.CenterAll,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.YearMonth))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.YearMonth").Text,
                                                Width = "50",
                                                ClassName =  NopColumnClassDefaults.CenterAll,
                                                },
                                                new ColumnProperty(nameof(TableReportModel.Quantity))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.Quantity").Text,
                                                Width = "50",
                                                ClassName =  NopColumnClassDefaults.CenterAll
                                                },
                                                new ColumnProperty(nameof(TableReportModel.UnitPriceExclTax))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.UnitPriceExclTax").Text,
                                                Width = "50",
                                                ClassName =  NopColumnClassDefaults.CenterAll
                                                },
                                                new ColumnProperty(nameof(TableReportModel.LineTotalExclTax))
                                                {
                                                Title = T("Plugins.Reports.ChartsAndTables.Table.Menu.LineTotalExclTax").Text,
                                                Width = "50",
                                                ClassName =  NopColumnClassDefaults.CenterAll
                                                }
                                                }
                                };

                                var reportTotalSaleSummaryColumnNumber = 11;
                                var reportQuantitySummaryColumnNumber = 9;
                            }

                            @await Html.PartialAsync("Table", gridModel)

                            <script>

                                function tablereportfootercallback(tfoot, data, start, end, display) {
                                    //update summary
                                    var postData = {
                                        StartDate: $('#@Html.IdFor(model => model.StartDate)').val(),
                                        EndDate: $('#@Html.IdFor(model => model.EndDate)').val(),
                                        OrderStatusId: $('#@Html.IdFor(model => model.OrderStatusId)').val(),
                                        PaymentStatusId: $('#@Html.IdFor(model => model.PaymentStatusId)').val(),
                                        StoreId: $('#@Html.IdFor(model => model.StoreId)').val(),
                                        ShippingMethod: $('#@Html.IdFor(model => model.ShippingMethod)').val(),
                                        PaymentMethod: $('#@Html.IdFor(model => model.PaymentMethod)').val(),
                                        VendorId: $('#@Html.IdFor(model => model.VendorId)').val(),
                                    };

                                    addAntiForgeryToken(postData);

                                    $.ajax({
                                        cache: false,
                                        type: "POST",
                                        url: '@Url.Action("ReportMenuTableAggregates", "ChartsAndTablesMenu")',
                                        data: postData,
                                        success: function (data, textStatus, jqXHR) {
                                            if (data) {
                                                for (var key in data) {
                                                    var reportTotalSaleSummary = '<div><strong>@T("Plugins.Reports.ChartsAndTables.Aggrerator.Summary").Text</strong></div>' +
                                                        '<div>@T("Plugins.Reports.ChartsAndTables.Aggrerator.TotalSalesValue").Text: <span>' + data['TotalSalesValue'] + '</span></div>'
                                                    var reportTotalSaleColumn = $('#tablereport-grid').DataTable().column(@(reportTotalSaleSummaryColumnNumber));
                                                    $(reportTotalSaleColumn.footer()).html(reportTotalSaleSummary);

                                                    var reportQuantitySummary = '<div><strong>@T("Plugins.Reports.ChartsAndTables.Aggrerator.Summary").Text</strong></div>' +
                                                        '<div>@T("Plugins.Reports.ChartsAndTables.Aggrerator.TotalQuantity").Text: <span>' + data['TotalQuantity'] + '</span></div>'
                                                    var reportQuantityColumn = $('#tablereport-grid').DataTable().column(@(reportQuantitySummaryColumnNumber));
                                                    $(reportQuantityColumn.footer()).html(reportQuantitySummary);
                                                }
                                            }
                                        }
                                    });
                                }
                            </script>

                            <script>
                                function tablereport(settings, json) {
                                    const $container = $('#tablereport');

                                    if ($container.children('button').length === 0) {
                                        const reportTotalSaleColumn = $('#tablereport-grid').DataTable();


                                        let allColumnHeaders = [];
                                        try {
                                            let cols = reportTotalSaleColumn.settings().init().columns;
                                            if (cols && Array.isArray(cols)) {
                                                allColumnHeaders = cols.map(col => (col.title || '').trim());
                                            }
                                        } catch { }

                                        const pageTitle = document.title || 'Exported Report';

                                        // Create buttons instance but do not auto-append the full container
                                        const buttons = new $.fn.dataTable.Buttons(reportTotalSaleColumn, {
                                            buttons: [
                                                {
                                                    extend: 'excelHtml5',
                                                    text: '@T("Admin.Common.ExportToExcel").Text',
                                                    title: pageTitle,
                                                    filename: pageTitle,
                                                    className: 'btn btn-secondary',
                                                            exportOptions: {
                                                             columns: function (idx, data, node) {
                                                                return true;
                                                            },
                                                            format: {
                                                            header: function (data, columnIdx) {
                                                            return allColumnHeaders[columnIdx] || data;
                                                            },
                                                            body: function (data, row, column) {
                                                                if (typeof data === 'string') {
                                                                    data = data
                                                                        .replace(/<br\s*\/?>/gi, '')
                                                                        .replace(/<\/?[^>]+(>|$)/g, "");
                                                                }
                                                               const num = parseFloat(data);
                                                               return !isNaN(num) && isFinite(num) ? num.toFixed(2) : data;
                                                            },
                                                            footer: function (data, row, column) {
                                                            return null;
                                                            }
                                                        }
                                                    }
                                                }
                                            ]
                                        });

                                        // Get the button element only (not the wrapping div)
                                        const $button = buttons.container().find('button');
                                        $container.append($button);

                                        // Register the button to DataTable
                                        reportTotalSaleColumn.buttons().container(); // activate the buttons internally
                                    }
                                }
                            </script>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @T("Plugins.Reports.ChartsAndTables.Orders.Menu.None")
            }
        </div>
    </div>
</section>
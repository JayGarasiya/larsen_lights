@model List<ProductModel>

@{
    var dontManageStock = await localizationService.GetLocalizedEnumAsync(ManageInventoryMethod.DontManageStock);
    var manageStock = await localizationService.GetLocalizedEnumAsync(ManageInventoryMethod.ManageStock);
    var manageStockByAttributes = await localizationService.GetLocalizedEnumAsync(ManageInventoryMethod.ManageStockByAttributes);
    var inventoryMethodName = string.Empty;
}

@foreach (var product in Model)
{
    var id = product.Id;

    {
        inventoryMethodName = product.ManageInventoryMethodId == (int)ManageInventoryMethod.DontManageStock ? dontManageStock
        : product.ManageInventoryMethodId == (int)ManageInventoryMethod.ManageStock ? manageStock : manageStockByAttributes;
        if (product.ManageInventoryMethodId == (int)ManageInventoryMethod.ManageStock && product.UseMultipleWarehouses)
        {
            inventoryMethodName += " (multi-warehouse)";
        }
    }

    <tr class="product-row">
        <td style="text-align: center; vertical-align:middle"><input class="check-box product-select checkboxGroups" id="product-select-@id" name="product-select-@id" type="checkbox" /></td>
        <td style="text-align:center; vertical-align:middle">
            <img src="@product.PictureThumbnailUrl"
                 alt="@product.Name"/>
        </td>
        <td><input class="form-control text-box single-line" id="name-@id" name="name-@id" type="text" value="@product.Name" /></td>
        <td><input class="form-control text-box single-line" id="sku-@id" name="sku-@id" type="text" value="@product.Sku" /></td>
        <td>
            <div class="input-postfix" data-postfix="@product.PrimaryStoreCurrencyCode">
                <input class="form-control text-box single-line" id="cost-@id" name="cost-@id" type="text" value="@product.ProductCost" />
            </div>
        </td>
        <td>
            <div class="input-postfix" data-postfix="@product.PrimaryStoreCurrencyCode">
                <input type="text" class="form-control" id="price-@id" name="price-@id" value="@product.Price" />
            </div>
        </td>
        <td>
            <div class="input-postfix" data-postfix="@product.PrimaryStoreCurrencyCode">
                <input type="text" class="form-control" id="old-price-@id" name="old-price-@id" value="@product.OldPrice" />
            </div>
        </td>
        <td style="text-align:center; vertical-align:middle">
            <span>@inventoryMethodName</span>
        </td>
        <td><input type="number" class="form-control" id="quantity-@id" name="quantity-@id" value="@product.StockQuantity" /></td>
        <td style="text-align: center; vertical-align:middle"><input class="check-box" id="published-@id" name="published-@id" type="checkbox" @(product.Published ? "checked = \"checked\"" : string.Empty) /></td>

        <td style="text-align:center; vertical-align:middle">
            <a class="btn btn-default" href="@Url.Action("Edit", "Product", new { area = "Admin", id = product.Id })">
                <i class="fa fa-eye"></i>
                @T("Admin.Common.View")
            </a>
        </td>
    </tr>
}
    <script>
        $(document).ready(function () {
            $('#btnRefresh').click(function () {
                updateTable('#poorder-grid');
                return false;
            });
        });

        function renderEdit(data, type, row, meta) {
            return '<button onclick=\"javascript:OpenWindow(\'@Url.Content("~/Admin/InventoryOrder/EditPoOrderPopup/")' + row.Id + '?btnId=btnRefresh&formId=poorder-form\' , 700, 650, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
        }

        function renderAdd(data, type, row, meta) {
            return '<a href="@Url.Content("~/Admin/InventoryOrder/PoOrderItemAdd/")' + row.Id + '" class="btn btn-primary"><i class="fas fa-plus-square"></i>@T("Admin.Common.AddNew")</a>';
        }
        function highlightproducts(row, data, index) {
            if (data.Published == false) {
                $(row).css('color', 'red')
            }
        }

        var childId = "";
        $(document).ready(function () {
            $('#btnRefreshpoOrderItems').click(function (name) {
                updateTable("#child" + childId + "_poorder_grid");
                return false;
            });
            setTimeout(function () {
                $('#poorder-grid tbody').on('click', 'td.child-control', function () {
                    var tr = $(this).closest('tr');
                    var tdi = tr.find('i.fa');
                    var row = $('#poorder-grid').DataTable().row(tr);
                    childId = row.data().Id;
                });
            }, 3000);
        });

        function renderPoOrderItemColumnEdit(data, type, row, meta) {
            return '<button onclick=\"javascript:OpenWindow(\'@Url.Content("~/Admin/InventoryOrder/PoOrderItemEditPopup?id=")' + data + '&btnId=btnRefreshpoOrderItems&formId=poorder-form\' , 500, 300, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
        }
    </script>
</form>
<script>
    function renderCustomDelete(data, type, row, meta) {
        return '<a href="#" class="btn btn-default" onclick="customDelete(\'' + data + '\');return false;"><i class="far fa-trash-alt"></i>@T("Admin.Common.Delete").Text</a>';
    }

    function customDelete(dataId) {
        if (confirm('@T("Admin.Common.DeleteConfirmation")')) {
            var postData = {
                id: dataId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                url: "@Html.Raw(Url.Action("DeletePoOrder", "InventoryOrder"))",
                type: "POST",
                dataType: "json",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    //display error if returned
                    if (data) {
                        display_nop_error(data);
                    }
                    //refresh grid
                    updateTable('#poorder-grid');
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert(errorThrown);
                }
            });
        }
        else {
            return false;
        }
    }

    function renderHasReceivedButton(data, type, row, meta) {
        return '<button onclick="getHasReceived(' + data + ', ' + row.Id + ' ,$(this));return false;" class="btn btn-default"> ' + (data ? '@T("Plugins.InventoryOrder.Fields.Received").Text' : '@T("Plugins.InventoryOrder.Fields.Unreceived").Text') + '</button>';
    }

    function getHasReceived(received, id, button) {
        var confirmText = ''
        if (received) {
            confirmText = '@T("Plugins.InventoryOrder.Fields.Received.AdditionalConfirm")'
        } else {
            confirmText = '@T("Plugins.InventoryOrder.Fields.UnReceived.AdditionalConfirm")'
        }
        if (confirm(confirmText)) {
            var postdata = {
                hasReceived: received,
                id: id
            }
            addAntiForgeryToken(postdata);
            $.ajax({
                cache: false,
                type: "Post",
                url: "@Url.Action("PoOrderUpdate", "InventoryOrder")",
                data: postdata,
                success: function (data) {
                    if (!data.Result) {
                        updateTable('#poorder-grid');
                        return;
                    }
                    else {
                        updateTable('#poorder-grid');
                        return;
                    }
                }
            });
        }
    }
</script>

<form asp-controller="InventoryOrder" asp-action="PoOrderItemExportExcelSelected" method="post" id="export-excel-poorderitem-selected-form">
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />
</form>
<nop-alert asp-alert-id="poorderitemexportExcelSelected" />
<script asp-location="Footer">
    $(document).ready(function () {
        $('#exportpoorderitemexcelselected').click(function (e) {
            e.preventDefault();
            var ids = selectedIds.join(",");
            if (!ids) {
                alert("@T("Plugins.InventoryOrder.PoOrder.NoPoOrders")");
            }
            else {
                $('#export-excel-poorderitem-selected-form #selectedIds').val(ids);
                $('#export-excel-poorderitem-selected-form').submit();
                updateTable('#poorder-grid');
            }
            return false;
        });
    });
</script>

@*Print packaging slips selected (XML). We don't use GET approach because it's limited to 2K-4K chars and won't work for large number of entities*@
<form asp-controller="InventoryOrder" asp-action="PdfPoInvoiceSelected" method="post" id="pdf-invoice-selected-form">
    <input type="hidden" id="selectedIds" name="selectedIds" value="" />
</form>

<script>
    $(document).ready(function () {
        $('#pdf-invoice-selected').click(function (e) {
            e.preventDefault();
            var ids = selectedIds.join(",");
            if (!ids) {
                $('#pdfInvoiceSelected-info').text("@T("Plugins.InventoryOrder.PoOrder.NoPoOrders")");
                $("#pdfInvoiceSelected").click();
            }
            else {
                $('#pdf-invoice-selected-form #selectedIds').val(ids);
                $('#pdf-invoice-selected-form').submit();
                updateTable('#poorder-grid');
            }
            return false;
        });
    });
</script>
<nop-alert asp-alert-id="pdfInvoiceSelected" />
@model PoOrderModel

@{
    Layout = "_AdminPopupLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.InventoryOrder.Fields.EditPoOrderTitle").Text;
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try { window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click(); }
        catch (e) { }
        window.close();
    </script>
}

<form asp-controller="InventoryOrder" asp-action="EditPoOrderPopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.InventoryOrder.Fields.EditPoOrderTitle")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="form-horizontal">
                    <div class="cards-group">
                        <div class="card card-default card-popup card-popup">
                            <div class="card-body">
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        <nop-label asp-for="Comment" />
                                    </div>
                                    <div class="col-sm-9">
                                        <nop-textarea asp-for="Comment" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        <nop-label asp-for="AvailableDateOnUTC" />
                                    </div>
                                    <div class="col-sm-9">
                                        <nop-editor asp-for="AvailableDateOnUTC" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
@model dynamic 

@{
    /*category navigation*/
    var categoryNavigation = await Component.InvokeAsync(typeof(CategoryNavigationViewComponent), new { currentCategoryId = ViewBag.CurrentCategoryId, currentProductId = ViewBag.CurrentProductId });

    /* manufacturer navigation*/
    var manufacturerNavigation = await Component.InvokeAsync(typeof(ManufacturerNavigationViewComponent), new { currentManufacturerId = ViewBag.CurrentManufacturerId });

    /* recently viewed products block*/
    var recentlyViewedProductsBlock = await Component.InvokeAsync(typeof(RecentlyViewedProductsBlockViewComponent), new { productThumbPictureSize = 111 });

    /* popular tags block*/
    var popularProductTags = await Component.InvokeAsync(typeof(PopularProductTagsViewComponent));

    /* polls block*/
    var pollBlock = await Component.InvokeAsync(typeof(PollBlockViewComponent), new { systemKeyword = "LeftColumnPoll" });

    /* vendor navigation*/
    var vendorNavigation = await Component.InvokeAsync(typeof(VendorNavigationViewComponent));

    var catalogProductsModel = Model == null ? null : Model.CatalogProductsModel as CatalogProductsModel;
}

@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = "left_side_column_top" })
<div class="blocks-wrapper">
    @if (Model != null && catalogProductsModel != null)
    {
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CategoryDetailsBeforeFilters, additionalData = Model })
        @await Html.PartialAsync("_CatalogFilters", catalogProductsModel)
    }

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnBefore })

    @*@await RenderSectionAsync("CatalogFilters", false)*@ @*sections don't work in partial views*@

    @if (!string.IsNullOrEmpty(await categoryNavigation.RenderHtmlContentAsync()))
    {
        <div class="block block-category-navigation">
            <h2 class="title">
                @T("Categories")
            </h2>
            @categoryNavigation
        </div>
    }

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnAfterCategoryNavigation })

    @if (!string.IsNullOrEmpty(await manufacturerNavigation.RenderHtmlContentAsync()))
    {
        <div class="block block-manufacturer-navigation">
            <h2 class="title">
                @T("Manufacturers")
            </h2>
            @manufacturerNavigation
        </div>
    }

    @if (!string.IsNullOrEmpty(await recentlyViewedProductsBlock.RenderHtmlContentAsync()))
    {
        <div class="block block-recently-viewed-products">
            <h2 class="title">
                @T("Products.RecentlyViewedProducts")
            </h2>
            @recentlyViewedProductsBlock
        </div>
    }

    @if (!string.IsNullOrEmpty(await popularProductTags.RenderHtmlContentAsync()))
    {
        <div class="block block-popular-tags">
            <h2 class="title">
                @T("Products.Tags.Popular")
            </h2>
            @popularProductTags
        </div>
    }

    @if (!string.IsNullOrEmpty(await pollBlock.RenderHtmlContentAsync()))
    {
        <div class="block block-poll">
            <h2 class="title">
                @T("Polls.Title")
            </h2>
            @pollBlock
        </div>
    }

    @if (!string.IsNullOrEmpty(await vendorNavigation.RenderHtmlContentAsync()))
    {
        <div class="block block-vendor-navigation">
            <h2 class="title">
                @T("Vendors")
            </h2>
            @vendorNavigation
        </div>
    }
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnAfter })
</div>

@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = "left_side_column_bottom" })
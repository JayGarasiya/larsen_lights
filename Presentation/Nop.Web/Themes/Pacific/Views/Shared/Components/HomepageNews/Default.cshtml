@model HomepageNewsItemsModel

@if (Model.NewsItems.Count > 0)
{
    <div class="news-list-homepage">
        <h2 class="title">
            @T("News")
        </h2>
        <div class="news-items">
            @foreach (var item in Model.NewsItems)
            {
                <div class="news-item">
                    <div class="news-head">
                        <span class="news-date">
                            <span class="day">@item.CreatedOn.Day.ToString("00")</span>
                            <span class="month">@item.CreatedOn.ToString("MMMM")</span>
                        </span>
                        <a class="news-title" href="@(await NopUrl.RouteGenericUrlAsync<NewsItem>(new { SeName = item.SeName }))">@item.Title</a>
                    </div>
                    <div class="news-body">
                        @Html.Raw(item.Short)
                    </div>
                    <div class="buttons">
                        <a href="@(await NopUrl.RouteGenericUrlAsync<NewsItem>(new { SeName = item.SeName }))" class="read-more"><span>@T("News.MoreInfo")</span></a>
                    </div>
                </div>
            }
        </div>
        <div class="view-all">
            <a href="@Url.RouteUrl(NopRouteNames.General.NEWS)"><span>@T("News.ViewAll")</span></a>
        </div>
    </div>

}
<script>
    function toggleOrderItemEditTrigger(element, togglefun) {
        if (typeof togglefun == 'function') {
            if ($(element).is(':checked'))
                togglefun(true, true);
            else
                togglefun(false, true);
        }
    }
    $(document).ready(function () {


        $('#refund-selected tr.parent-item td.child-control').click(function () {
            var childItem = $(this).parent().next('tr.child-item')
            childItem.slideToggle("slow", "swing", function () {
                if ($(this).is(':hidden')) {
                    $(this).find('input[type=checkbox][class=checkboxGroups]:checked').each(function () {
                        $(this).prop('checked', false).change();
                    });
                }
            });
        });

        $(window).keydown(function (event) {
            if (event.keyCode == 13) {
                event.preventDefault();
                return false;
            }
        });

        $("#refund-selected .decimal").on("input", function () {
            var value = parseFloat($(this).val());
            if (!isNaN(value)) {
                // Format the value to 2 decimal places
                $(this).val(value.toFixed(2));
            }
        }).on("blur", function () {
            var value = parseFloat($(this).val());
            if (!isNaN(value)) {
                $(this).val(value.toFixed(2));
            }
        });

        // For "number" class (0 decimals)
        $("#refund-selected .number").on("input", function () {
            var value = parseInt($(this).val(), 10);
            if (!isNaN(value)) {
                $(this).val(value);
            }
        }).on("blur", function () {
            var value = parseInt($(this).val(), 10);
            if (!isNaN(value)) {
                $(this).val(value);
            }
        });

        // Add manual increment/decrement functionality
        $("#refund-selected .decimal, #refund-selected .number").each(function () {
            var $this = $(this);
            var step = $this.hasClass("decimal") ? 0.1 : 1;
        
            // Adding event listener for arrow keys (up/down)
            $this.on("keydown", function (e) {
                if (e.key === "ArrowUp") {
                    var currentValue = parseFloat($this.val());
                    if (!isNaN(currentValue)) {
                        $this.val((currentValue + step).toFixed($this.hasClass("decimal") ? 2 : 0)); // Increment
                    }
                     $(this).trigger('input');
                } else if (e.key === "ArrowDown") {
                    var currentValue = parseFloat($this.val());
                    if (!isNaN(currentValue)) {
                        $this.val((currentValue - step).toFixed($this.hasClass("decimal") ? 2 : 0)); // Decrement
                    }
                     $(this).trigger('input');
                }
            });
        });

        $("#@Html.IdFor(model => model.OrderSubtotalInclTaxValue),#@Html.IdFor(model => model.OrderSubtotalExclTaxValue)").prop('disabled', true);
        $("#@Html.IdFor(model => model.OrderSubTotalDiscountInclTaxValue),#@Html.IdFor(model => model.OrderSubTotalDiscountExclTaxValue)").prop('disabled', true);
        $("#@Html.IdFor(model => model.TaxValue)").prop('disabled', true);
        $("#@Html.IdFor(model => model.OrderTotalDiscountValue)").prop('disabled', true);

        @if(Model.PaymentMethodAdditionalFeeInclTaxValue > decimal.Zero || Model.PaymentMethodAdditionalFeeExclTaxValue > decimal.Zero)
        {
            <text>
                $("#@Html.IdFor(model => model.PaymentMethodAdditionalFeeInclTaxValue),#@Html.IdFor(model => model.PaymentMethodAdditionalFeeExclTaxValue)").prop('disabled', false);
            </text>
        }
    });
</script>

@*render scripts*@
<script asp-location="Footer">
    function @(itemChangeHandlerFuncName)(){
        $('#calculaterefund').attr('disabled', true);
        $.ajax({
            cache: false,
            url: "@Html.Raw(Url.Action("refundorder_itemchange", "taxjar", new { orderId = Model.Id }))",
            data: $('#refund-order-form').serialize(),
            type: "POST",
            success: function (data, textStatus, jqXHR) {
                if (data.refundOrderTotal) {
                    $('#calculaterefund').text(data.refundOrderTotal);
                }
                if (data.pricesIncludeTax) {
                    $("#@Html.IdFor(model => model.OrderSubtotalInclTaxValue)").val(data.orderSubtotal);
                    $("#@Html.IdFor(model => model.OrderSubTotalDiscountInclTaxValue)").val(data.orderSubtotalDiscount);
                } else {
                    $("#@Html.IdFor(model => model.OrderSubtotalExclTaxValue)").val(data.orderSubtotal);
                    $("#@Html.IdFor(model => model.OrderSubTotalDiscountExclTaxValue)").val(data.orderSubtotalDiscount);
                }
                if (data.orderTax) {
                    $("#@Html.IdFor(model => model.TaxValue)").val(data.orderTax);
                }
                if (data.orderTotalDisocunt) {
                    $("#@Html.IdFor(model => model.OrderTotalDiscountValue)").val(data.orderTotalDisocunt);
                }
                if (data.message) {
                    $('.max-refund-error').text(data.message);
                }
                else {
                    $('.max-refund-error').text(data.message);
                }
            },
            complete: function (jqXHR, textStatus) {
                $('#calculaterefund').attr('disabled', false);
            }
        });
    }
    $(document).ready(function() {
        @(itemChangeHandlerFuncName)();
        @Html.Raw(itemChangeScriptsBuilder.ToString())
    });
</script>
                <nop-label asp-for="ValidateBilling" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ValidateBilling" />
                <span asp-validation-for="ValidateBilling"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ValidateShipping" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ValidateShipping" />
                <span asp-validation-for="ValidateShipping"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="OnlyNewAddress" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="OnlyNewAddress" />
                <span asp-validation-for="OnlyNewAddress"></span>
            </div>
        </div>
    </nop-nested-setting>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="TaxOriginAddressTypeId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="TaxOriginAddressTypeId" asp-items="@Model.TaxOriginAddressTypes" />
            <span asp-validation-for="TaxOriginAddressTypeId"></span>
        </div>
        <script>
            $(document).ready(function () {
                $('#@Html.IdFor(model => model.TaxOriginAddressTypeId)').change(changeOriginAddressType);
                changeOriginAddressType();
            });

            function changeOriginAddressType() {
                warningValidation(
                    '@Url.Action("ChangeOriginAddressType", "TaxJar")',
                    '@Html.NameFor(model => model.TaxOriginAddressTypeId)',
                    { typeId: $('#@Html.IdFor(model => model.TaxOriginAddressTypeId)').val() });
            }
        </script>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ExcludeTaxOnStateProvinceIds" />
        </div>
        <div class="col-md-9">
            <div class="input-group-append input-group-required">
                <div class="input-group">
                    <nop-select asp-for="ExcludeTaxOnStateProvinceIds" asp-items="Model.AvailableStates" asp-multiple="true" />
                </div>
                <div class="input-group-btn">
                    <nop-required />
                </div>
            </div>
            <script>
                $(document).ready(function () {
                    var excludeTaxOnStateProvinceIdsInput = $('#@Html.IdFor(model => model.ExcludeTaxOnStateProvinceIds)').select2({

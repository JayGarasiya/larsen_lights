        <div class="col-md-9">
            <nop-editor asp-for="AttachPdfInvoiceToOrderRefundSelectedEmail" />
            <span asp-validation-for="AttachPdfInvoiceToOrderRefundSelectedEmail"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="CCAttributeId" />

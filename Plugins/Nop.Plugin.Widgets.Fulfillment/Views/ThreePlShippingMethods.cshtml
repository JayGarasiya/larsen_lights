@model ThreePlShippingMethodSearchModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Widgets.Fulfillment.Fields.ManageCarriers.Title").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Fulfillment.3PLCarriers");
}

<nop-antiforgery-token />
<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Widgets.Fulfillment.Fields.ManageCarriers.Title")
        <small>
            <i class="fa fa-arrow-circle-left"></i>
            <a asp-action="Configure" asp-controller="Fulfillment">@T("Admin.Configuration.Plugins.Misc.BackToList")</a>
        </small>
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "shipping-grid",
                            UrlRead = new DataUrl("ThreePlShippingMethods", "Fulfillment", null),
                            UrlUpdate = new DataUrl("ThreePlShippingMethodUpdate", "Fulfillment", null),
                            UrlDelete = new DataUrl("ThreePlShippingMethodDelete", "Fulfillment", null),
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(ThreePlShippingMethodModel.ShippingMethod))
                                {
                                    Title = T("Plugins.Widgets.Fulfillment.Fields.ShippingMethod").Text,
                                    Width = "300",
                                    Editable = true,
                                    EditType = EditType.String
                                },
                                new ColumnProperty(nameof(ThreePlShippingMethodModel.ThreePlCarrier))
                                {
                                    Title = T("Plugins.Widgets.Fulfillment.Fields.ThreePlCarrier").Text,
                                    Editable = true,
                                    EditType = EditType.String
                                },
                                new ColumnProperty(nameof(ThreePlShippingMethodModel.ThreePlService))
                                {
                                    Title = T("Plugins.Widgets.Fulfillment.Fields.ThreePlService").Text,
                                    Editable = true,
                                    EditType = EditType.String
                                },
                                new ColumnProperty(nameof(ThreePlShippingMethodModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonsInlineEdit()
                                },
                                new ColumnProperty(nameof(ThreePlShippingMethodModel.Id))
                                {
                                    Title = T("Admin.Common.Delete").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text)
                                }
                            }
                        })
                        <div class="card card-default no-margin">
                            <div class="card-header">
                                @T("Admin.Common.AddNewRecord")
                            </div>
                            <div class="card-body">
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.AddThreePlShippingMethod.ShippingMethod" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.AddThreePlShippingMethod.ShippingMethod" />
                                        <span asp-validation-for="@Model.AddThreePlShippingMethod.ShippingMethod"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.AddThreePlShippingMethod.ThreePlCarrier" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.AddThreePlShippingMethod.ThreePlCarrier" />
                                        <span asp-validation-for="@Model.AddThreePlShippingMethod.ThreePlCarrier"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.AddThreePlShippingMethod.ThreePlService" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.AddThreePlShippingMethod.ThreePlService" />
                                        <span asp-validation-for="@Model.AddThreePlShippingMethod.ThreePlService"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-9 offset-md-3">
                                        <button type="button" id="addThreePlShippingMethod" class="btn btn-primary">@T("Admin.Common.AddNewRecord")</button>
                                    </div>
                                </div>
                            </div>
                            <script>
                                $(document).ready(function () {
                                    $('#addThreePlShippingMethod').click(function () {
                                        $('#addThreePlShippingMethod').attr('disabled', true);
                                        var postData = {
                                            ShippingMethod: $("#@Html.IdFor(model => model.AddThreePlShippingMethod.ShippingMethod)").val(),
                                            ThreePlCarrier: $("#@Html.IdFor(model => model.AddThreePlShippingMethod.ThreePlCarrier)").val(),
                                            ThreePlService: $("#@Html.IdFor(model => model.AddThreePlShippingMethod.ThreePlService)").val()
                                        };
                                        addAntiForgeryToken(postData);

                                        $.ajax({
                                            cache: false,
                                            type: "POST",
                                            url: "@Html.Raw(Url.Action("ThreePlShippingMethodAdd", "Fulfillment"))",
                                            data: postData,
                                            success: function (data, textStatus, jqXHR) {
                                                if (data.Result) {
                                                    //reload grid
                                                    updateTable('#resources-grid');

                                                    //clear input value
                                                    $("#@Html.IdFor(model => model.AddThreePlShippingMethod.ShippingMethod)").val('');
                                                    $("#@Html.IdFor(model => model.AddThreePlShippingMethod.ThreePlCarrier)").val('');
                                                    $("#@Html.IdFor(model => model.AddThreePlShippingMethod.ThreePlService)").val('');
                                                } else {
                                                    //display errors if returned
                                                    display_nop_error(data);
                                                }
                                            },
                                            complete: function (jqXHR, textStatus) {
                                                $('#addThreePlShippingMethod').attr('disabled', false);
                                            }
                                        });
                                    });
                                });
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@model MessageTemplateModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.ContentManagement.MessageTemplates.EditMessageTemplateDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Message templates");

    Layout = "_AdminLayout";
    var isCustomerNotificationMail = Model.Name == MessageTemplateSystemNames.ORDER_PLACED_CUSTOMER_NOTIFICATION;
    var CustomerRoleId = 0;
    var customerAvailableRoles = (await _customerService.GetAllCustomerRolesAsync(showHidden: true)).Select(type => new SelectListItem(type.Name, type.Id.ToString())).ToList(); ;
    var customerRoleName = ViewBag.RoleName;
    var messageTemplateName = !string.IsNullOrWhiteSpace(customerRoleName) ? $"{Model.Name}{customerRoleName}" : Model.Name;
}

<form asp-controller="MessageTemplate" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.ContentManagement.MessageTemplates.EditMessageTemplateDetails") - @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Admin.ContentManagement.MessageTemplates.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>

            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>

            @if (isCustomerNotificationMail)
            {
                <button type="button" name="importexcel" class="btn btn-success" data-toggle="modal" data-target="#customMail-window">
                    <i class="far fa-clone"></i>
                    @T("Admin.ContentManagement.MessageTemplates.Copy")
                </button>
            }
            else
            {
                <button type="submit" id="message-template-copy" name="message-template-copy" class="btn btn-success">
                    <i class="far fa-clone"></i>
                    @T("Admin.ContentManagement.MessageTemplates.Copy")
                </button>
                <nop-action-confirmation asp-button-id="message-template-copy" />
            }

            <span id="message-template-delete" class="btn btn-danger">
                <i class="far fa-trash-can"></i>
                @T("Admin.Common.Delete")
            </span>
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.MessageTemplateDetailsButtons, additionalData = Model })
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="message-template-delete" />
<nop-action-confirmation asp-button-id="message-template-copy" />

<div id="customMail-window" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="customMail-window-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="customMail-window-title">@T("Plugins.Misc.InvoicePDF.Copy.Template")</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <form asp-controller="InvoicePDF" asp-action="CopyTemplate" method="post">
                <input asp-for="Id" type="hidden" />
                <div class="form-horizontal">
                    <div class="modal-body">
                        <div class="form-group row">
                            <div class="col-md-10">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <label class="col-form-label" for="Roles">@T("Plugins.Misc.InvoicePDF.Customer.Role")</label>
                                    </div>
                                    <div class="col-md-8">
                                        <nop-select asp-for="@CustomerRoleId" asp-items="@customerAvailableRoles" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            @T("Admin.ContentManagement.MessageTemplates.Copy")
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

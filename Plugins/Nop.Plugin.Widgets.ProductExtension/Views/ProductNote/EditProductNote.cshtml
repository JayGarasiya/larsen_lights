@model ProductNoteModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Widgets.ProductExtension.ProductNote.EditProductNoteDetails").Text;
    //tour step
    ViewBag.TourStep = TourStep.Store;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(ProductExtensionDefaults.ProductNotesSystemName);
}

<form asp-controller="ProductExtension" asp-action="EditProductNote" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Widgets.ProductExtension.ProductNote.EditProductNoteDetails") - @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="ProductNotes">@T("Plugins.Widgets.ProductExtension.ProductNote.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="product-note-delete" class="btn btn-danger">
                <i class="far fa-trash-alt"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Widgets.ProductExtension/Views/ProductNote/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="product-note-delete" />
@model ProductAttributeValueConditionModel

@{
    var controlId = $"{NopCatalogDefaults.ProductAttributePrefix}{Model.ProductAttributeMappingId}";
}

<form asp-controller="ProductExtension" asp-action="ProductAttributeValueConditions" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <div class="form-horizontal">
        <div class="card-body">
            <div class="row margin-b-5">
                <div class="col-md-12">
                    @Html.Raw(string.Format(T("Plugins.Widgets.ProductExtension.ProductAttributeValue.ConditionDescription").Text, Model.TextPrompt, Model.Name))
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-10 offset-sm-2">
                    @foreach (var attributeValue in Model.Values)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="@attributeValue.Id" id="@(controlId)_@(attributeValue.Id)" name="@(controlId)" checked="@attributeValue.IsPreSelected">
                            <label class="form-check-label" for="@(controlId)_@(attributeValue.Id)">
                                @attributeValue.Name
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 text-center margin-t-5">
            <button type="submit" name="product-attribute-value-condition" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
</form>
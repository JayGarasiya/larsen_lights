@model TypeProductSearchModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Widgets.MakeTypeModel.TypeProducts").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(MakeTypeModelDefaults.TypeProduct);
}

@{
    const string hideSearchBlockAttributeName = "TypeProducts.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Widgets.MakeTypeModel.TypeProducts")
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-types" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "types-product-grid",
                            UrlRead = new DataUrl("TypeList", "MakeTypeModel", null),
                            UrlDelete = new DataUrl("TypeDelete", "MakeTypeModel", null),
                            UrlUpdate = new DataUrl("TypeUpdate", "MakeTypeModel", null),
                            SearchButtonId = "search-types",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchName))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(TypeProductModel.Name))
                                {
                                    Title = T("Plugins.Widgets.MakeTypeModel.TypeProduct.Fields.Name").Text,
                                    Width = "500",
                                    Editable = true,
                                    EditType = EditType.String
                                },
                                new ColumnProperty(nameof(TypeProductModel.Published))
                                {
                                    Title = T("Plugins.Widgets.MakeTypeModel.TypeProduct.Fields.Published").Text,
                                    Width = "50",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean(),
                                    Editable = true,
                                    EditType = EditType.Checkbox
                                },
                                new ColumnProperty(nameof(TypeProductModel.DisplayOrder))
                                {
                                    Title = T("Plugins.Widgets.MakeTypeModel.TypeProduct.Fields.DisplayOrder").Text,
                                    Width = "50",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Editable = true,
                                    EditType = EditType.Number
                                },
                                new ColumnProperty(nameof(TypeProductModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "50",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonsInlineEdit()
                                },
                                new ColumnProperty(nameof(TypeProductModel.Id))
                                {
                                    Title = T("Admin.Common.Delete").Text,
                                    Width = "50",
                                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                    ClassName = NopColumnClassDefaults.Button
                                }
                            }
                        })

                        <div class="card card-default">
                            <div class="card-header">
                                @T("Admin.Common.AddNewRecord")
                            </div>
                            <div class="card-body">
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.AddTypeProduct.Name" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.AddTypeProduct.Name" />
                                        <span asp-validation-for="@Model.AddTypeProduct.Name"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.AddTypeProduct.Published" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.AddTypeProduct.Published" />
                                        <span asp-validation-for="@Model.AddTypeProduct.Published"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <nop-label asp-for="@Model.AddTypeProduct.DisplayOrder" />
                                    </div>
                                    <div class="col-md-9">
                                        <nop-editor asp-for="@Model.AddTypeProduct.DisplayOrder" />
                                        <span asp-validation-for="@Model.AddTypeProduct.DisplayOrder"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-9 offset-md-3">
                                        <button type="button" id="addTypeProduct" class="btn btn-primary">@T("Admin.Common.AddNewRecord")</button>
                                    </div>
                                </div>
                            </div>
                            <script>
                                $(document).ready(function () {
                                    $('#addTypeProduct').click(function () {
                                        $('#addTypeProduct').attr('disabled', true);
                                        var postData = {
                                            Name: $("#@Html.IdFor(model => model.AddTypeProduct.Name)").val(),
                                            Published: $("#@Html.IdFor(model => model.AddTypeProduct.Published)").val(),
                                            DisplayOrder: $("#@Html.IdFor(model => model.AddTypeProduct.DisplayOrder)").val()
                                        };
                                        addAntiForgeryToken(postData);

                                        $.ajax({
                                            cache: false,
                                            type: "POST",
                                            url: "@Html.Raw(Url.Action("TypeAdd", "MakeTypeModel", null))",
                                            data: postData,
                                            success: function (data, textStatus, jqXHR) {
                                                if (data.Result) {
                                                    //reload grid
                                                    updateTable('#types-product-grid');

                                                    //clear input value
                                                    $("#@Html.IdFor(model => model.AddTypeProduct.Name)").val('');
                                                    $("#@Html.IdFor(model => model.AddTypeProduct.DisplayOrder)").data("kendoNumericTextBox").value(0);
                                                } else {
                                                    //display errors if returned
                                                    display_nop_error(data);
                                                }
                                            },
                                            complete: function (jqXHR, textStatus) {
                                                $('#addTypeProduct').attr('disabled', false);
                                            }
                                        });
                                    });
                                });
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

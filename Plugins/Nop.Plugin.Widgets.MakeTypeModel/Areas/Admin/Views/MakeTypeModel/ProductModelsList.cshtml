@model ModelProductSearchModel

@{ 
    const string hideModelProductBlockAttributeName = "ProductPage.HideModelProductBlock";
    var hideModelProductBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideModelProductBlockAttributeName);
}
<input type="hidden" asp-for="ProductId" />
<nop-card asp-name="product-model" asp-icon="fas fa-truck" asp-title="@T("Plugins.Widgets.MakeTypeModel.ModelProducts")" asp-hide-block-attribute-name="@hideModelProductBlockAttributeName" asp-hide="@hideModelProductBlock" asp-advanced="false">
    <div class="card-body">
        <div class="cards-group">
            <div class="card card-search">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchName" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="SearchName" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchInDescription" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="SearchInDescription" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchMakeName" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="SearchMakeName" asp-items="Model.AvailableMakes" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchTypeName" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="SearchTypeName" asp-items="Model.AvailableTypes" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="text-center col-12">
                            <button type="button" id="search-product-models" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "model-products",
                        UrlRead = new DataUrl("ProductModelsList", "MakeTypeModel", new RouteValueDictionary { [nameof(Model.ProductId)] = Model.ProductId }),
                        UrlDelete = new DataUrl("ProductModelDelete", "MakeTypeModel",null),
                        SearchButtonId = "search-product-models",
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                        Filters = new List<FilterParameter>
                        {
                            new FilterParameter(nameof(Model.ProductId)),
                            new FilterParameter(nameof(Model.SearchName)),
                            new FilterParameter(nameof(Model.SearchInDescription), typeof(bool)),
                            new FilterParameter(nameof(Model.SearchMakeName)),
                            new FilterParameter(nameof(Model.SearchTypeName))
                        },
                        ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(ModelProductModel.Name))
                            {
                                Title = T("Plugins.Widgets.MakeTypeModel.ModelProduct.Fields.Name").Text,
                                Width = "300"
                            },
                            new ColumnProperty(nameof(ModelProductModel.Description))
                            {
                                Title = T("Plugins.Widgets.MakeTypeModel.ModelProduct.Fields.Description").Text,
                                Width = "300"
                            },
                            new ColumnProperty(nameof(ModelProductModel.MakeName))
                            {
                                Title = T("Plugins.Widgets.MakeTypeModel.ModelProduct.Fields.MakeName").Text,
                                Width = "300"
                            },
                            new ColumnProperty(nameof(ModelProductModel.TypeName))
                            {
                                Title = T("Plugins.Widgets.MakeTypeModel.ModelProduct.Fields.TypeName").Text,
                                Width = "300"
                            },
                            new ColumnProperty(nameof(ModelProductModel.Published))
                            {
                                Title = T("Plugins.Widgets.MakeTypeModel.ModelProduct.Fields.Published").Text,
                                Width = "100",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Render = new RenderBoolean()
                            },
                            new ColumnProperty(nameof(ModelProductModel.DisplayOrder))
                            {
                                Title = T("Plugins.Widgets.MakeTypeModel.ModelProduct.Fields.DisplayOrder").Text,
                                Width = "100",
                                ClassName = NopColumnClassDefaults.CenterAll,
                            },
                            new ColumnProperty(nameof(ModelProductModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "50",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderCustom("renderProductModelEdit")
                            },
                            new ColumnProperty(nameof(ModelProductModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "50",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text)
                            }
                        }
                    })
                
                    <script>
                        function renderProductModelEdit(data, type, row, meta) {
                            return '<button onclick=\"javascript:OpenWindow(\'@Url.Content("~/Admin/MakeTypeModel/ProductModelEditPopup/")?productModelId=' + data + '&btnId=btnRefreshProductModels&formId=product-form\', 800, 750, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                        }
                    </script>
                </div>
                <div class="card-footer">
                    <button type="submit" id="btnAddNewProduct"
                            onclick="javascript:OpenWindow('@(Url.Action("ProductModelsAddPopup", "MakeTypeModel", new { productId = Model.ProductId, btnId = "btnRefreshProductModels", formId = "product-form" }))', 800, 800, true); return false;"
                            class="btn btn-primary">
                        @T("Plugins.Widgets.MakeTypeModel.ModelProduct.AddNew")
                    </button>
                    <button type="submit" id="btnRefreshProductModels" style="display: none"></button>
                    <script>
                        $(document).ready(function () {
                            $('#btnRefreshProductModels').click(function () {
                                //refresh grid
                                updateTable('#model-products');

                                //return false to don't reload a page
                                return false;
                            });
                        });
                    </script>
                </div>
            </div>
        </div>
    </div>
</nop-card>
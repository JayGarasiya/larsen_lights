@model PriceImportSearchModel

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Widgets.MakeTypeModel.Navigation.PriceImports").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName(MakeTypeModelDefaults.PriceImports);
}

@{
    const string hideSearchBlockAttributeName = "ProductImports.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Widgets.MakeTypeModel.Navigation.PriceImports")
    </h1>
    <div class="float-right">
        <form asp-action="PriceImport" asp-controller="MakeTypeModel" method="get">
            <button type="submit" class="btn bg-olive">
                <i class="fa fa-upload"></i>
                @T("Admin.Common.Import")
            </button>
        </form>
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>
                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchImportStatus" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="SearchImportStatus" asp-items="Model.AvailableImportStatuses" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="VendorId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="VendorId" asp-items="Model.AvailableVendors" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-product-imports" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                   {
                       Name = "import-price-grid",
                       UrlRead = new DataUrl("PriceImportList", "MakeTypeModel", null),
                       UrlDelete = new DataUrl("PriceImportDelete", "MakeTypeModel", null),
                       SearchButtonId = "search-product-imports",
                       Length = Model.PageSize,
                       LengthMenu = Model.AvailablePageSizes,
                       PrimaryKeyColumn = nameof(PriceImportModel.Id),
                       Filters = new List<FilterParameter>
                        {
                        new FilterParameter(nameof(Model.SearchImportStatus)),
                        new FilterParameter(nameof(Model.VendorId))
                        },
                       ColumnCollection = new List<ColumnProperty>
                        {
                        new ColumnProperty(null)
                        {
                        Render = new RenderChildCaret(),
                        Width = "5",
                        Searchable = false,
                        ClassName =  NopColumnClassDefaults.ChildControl,
                        },
                        new ColumnProperty(nameof(PriceImportModel.FileName))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.FileName").Text,
                        Width = "150",
                        },
                        new ColumnProperty(nameof(PriceImportModel.ImportStatus))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.ImportStatus").Text,
                        Width = "100",
                        },
                        new ColumnProperty(nameof(PriceImportModel.VendorName))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.VendorId").Text,
                        Width = "100",
                        },
                        new ColumnProperty(nameof(PriceImportModel.RowNumber))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.RowNumber").Text,
                        Width = "50",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        },
                        new ColumnProperty(nameof(PriceImportModel.CreatedOnUtc))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.CreatedOnUtc").Text,
                        Width = "100",
                        Render = new RenderDate()
                        },
                        new ColumnProperty(nameof(PriceImportModel.Id))
                        {
                        Title = T("Admin.Common.Edit").Text,
                        Width = "50",
                        Render = new RenderCustom("renderEditButton"),
                        ClassName = NopColumnClassDefaults.CenterAll
                        },
                        new ColumnProperty(nameof(PriceImportModel.Id))
                        {
                        Title = T("Admin.Common.Delete").Text,
                        Width = "50",
                        Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                        ClassName = NopColumnClassDefaults.CenterAll
                        }
                        },
                       ChildTable = new DataTablesModel
                       {
                           Name = "PriceRange-grid",
                           UrlRead = new DataUrl("PriceImportRange", "MakeTypeModel", null),
                           IsChildTable = true,
                           Paging = false,
                           Length = Model.PageSize,
                           LengthMenu = Model.AvailablePageSizes,
                           Filters = new List<FilterParameter>
                        {
                        new FilterParameter(nameof(PriceRangeSearchModel.PriceImportId), nameof(PriceImportModel.Id), true)
                        },
                           ColumnCollection = new List<ColumnProperty>
                        {
                        new ColumnProperty(nameof(PriceRangeModel.PricePercentage))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.PricePercentage").Text,
                        },
                        new ColumnProperty(nameof(PriceRangeModel.PriceAmount))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.PriceAmount").Text,
                        },
                        new ColumnProperty(nameof(PriceRangeModel.FromPrice))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.FromPrice").Text,
                        },
                        new ColumnProperty(nameof(PriceRangeModel.ToPrice))
                        {
                        Title = T("Plugins.Widgets.MakeTypeModel.PriceImport.Fields.ToPrice").Text,
                        },
                        }
                       }
                   })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function renderEditButton(data, type, row, meta) {

        console.log("data: " + data);
        console.log("row: " + row.ImportStatus)

        // Check ImportStatus per row
        if (row.ImportStatus === 'Complete') {
            return '<a class="btn btn-default" href="/Admin/MakeTypeModel/UpdatePriceImport/' + data + '"><i class="fas fa-pencil-alt"></i> Edit</a>';
        } else {
            return ''; // No button if not complete
        }
    }
</script>

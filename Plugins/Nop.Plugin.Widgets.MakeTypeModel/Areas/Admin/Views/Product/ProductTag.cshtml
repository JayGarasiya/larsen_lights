@model OverrideProductModel

<link rel="stylesheet" href="~/lib_npm/jquery-tageditor/jquery.tag-editor.css" />
<script src="~/lib_npm/jquery-tageditor/jquery.caret.min.js"></script>
<script src="~/lib_npm/jquery-tageditor/jquery.tag-editor.min.js"></script>

<div class="form-group row">
    <div class="col-md-3">
        <nop-label asp-for="@Model.ProductTags" />
    </div>
    <div class="col-md-9">
        <input type="hidden" id="ProductTags" name="ProductTags" value="@Model.ProductTags" />
        <input type="text" id="product-tags-editor" class="form-control" />
        <span asp-validation-for="@Model.ProductTags"></span>
    </div>
</div>


<script>
    $(document).ready(function () {

        var hidden = $("#ProductTags");
        var ui = $("#product-tags-editor");

        ui.tagEditor({
            initialTags: hidden.val()
                ? hidden.val().split(',')
                : [],
            delimiter: ',',
            placeholder: '@T("Admin.Catalog.Products.Fields.ProductTags.Placeholder")',

            onChange: function (field, editor, tags) {
                hidden.val(tags.join(','));
            }
        });

    });
</script>

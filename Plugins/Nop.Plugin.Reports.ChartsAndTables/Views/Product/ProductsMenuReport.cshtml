@model ChartsAndTablesSearchModel
@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Reports.ChartsAndTables.Products").Text;

    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Plugins.Reports.ChartsAndTables.Products");

    if(Model.ProductReport)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/chart.js/chart.umd.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/buttons.html5.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/report.chart.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/jszip.min.js", excludeFromBundle: true);
    }
}

@{
    const string hideSearchBlockAttributeName = "ReportsProductMenu.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    const string hideProductBlockAttributeName = "ReportsProductMenu.HideProductBlock";
    var hideProductBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideProductBlockAttributeName);

    const string hideProductAttributeBlockAttributeName = "ReportsProductMenu.HideProductAttributeBlock";
    var hideProductAttributeBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideProductAttributeBlockAttributeName, defaultValue: true);

    const string hideCategoryBlockAttributeName = "ReportsProductMenu.HideCategoryBlock";
    var hideCategoryBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCategoryBlockAttributeName, defaultValue: true);

    const string hideManufacturerBlockAttributeName = "ReportsProductMenu.HideManufacturerBlock";
    var hideManufacturerBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideManufacturerBlockAttributeName, defaultValue: true);

    const string hideVendorBlockAttributeName = "ReportsProductMenu.HideVendorBlock";
    var hideVendorBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideVendorBlockAttributeName, defaultValue: true);
 }

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Reports.ChartsAndTables.Products")
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            @if (Model.ProductReport)
            {
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>

                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="StartDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="StartDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="EndDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="EndDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row" @(Model.IsLoggedInAsVendor ? Html.Raw("style='display: none;'") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="OrderStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="OrderStatusId" asp-items="Model.AvailableOrderStatuses" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="PaymentStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="form-group row" @(Model.AvailableStores.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="StoreId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="CategoryId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="CategoryId" asp-items="Model.AvailableCategories" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="ManufacturerId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="ManufacturerId" asp-items="Model.AvailableManufacturers" />
                                            </div>
                                        </div>
                                        <div class="form-group row" @(Model.IsLoggedInAsVendor ? Html.Raw("style='display: none;'") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="VendorId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="VendorId" asp-items="Model.AvailableVendors" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="text-center col-12">
                                        <button type="button" id="btnGenerate" class="btn btn-primary btn-search">
                                            <i class="fas fa-chart-line"></i>
                                            @T("Plugins.Reports.ChartsAndTables.Generate")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <nop-cards id="reports-menu-products-cards">
                    @if (Model.ProductMenuProductReport)
                    {
                        <nop-card asp-name="products-report" asp-icon="fab fa-product-hunt" asp-title="@T("Plugins.Reports.ChartsAndTables.Products.Menu.Product")" asp-hide-block-attribute-name="@hideProductBlockAttributeName" asp-hide="@hideProductBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Product/_ProductsMenuReport.Products.cshtml", Model)</nop-card>
                    }
                    @if (Model.ProductMenuProductAttributeReport)
                    {
                        <nop-card asp-name="products-attribute-report" asp-icon="fas fa-list" asp-title="@T("Plugins.Reports.ChartsAndTables.Products.Menu.ProductAttribute")" asp-hide-block-attribute-name="@hideProductAttributeBlockAttributeName" asp-hide="@hideProductAttributeBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Product/_ProductsMenuReport.ProductsAttribute.cshtml", Model)</nop-card>
                    }
                    @if (Model.ProductMenuCategoryReport)
                    {
                        <nop-card asp-name="products-category-report" asp-icon="fas fa-th-large" asp-title="@T("Plugins.Reports.ChartsAndTables.Products.Menu.Category")" asp-hide-block-attribute-name="@hideCategoryBlockAttributeName" asp-hide="@hideCategoryBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Product/_ProductsMenuReport.Category.cshtml", Model)</nop-card>
                    }
                    @if (Model.ProductMenuManufacturerReport)
                    {
                        <nop-card asp-name="products-manufacturer-report" asp-icon="fas fa-industry" asp-title="@T("Plugins.Reports.ChartsAndTables.Products.Menu.Manufacturer")" asp-hide-block-attribute-name="@hideManufacturerBlockAttributeName" asp-hide="@hideManufacturerBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Product/_ProductsMenuReport.Manufacturer.cshtml", Model)</nop-card>
                    }
                    @if (Model.ProductMenuVendorReport)
                    {
                        <nop-card asp-name="products-vendor-report" asp-icon="far fa-user" asp-title="@T("Plugins.Reports.ChartsAndTables.Products.Menu.Vendor")" asp-hide-block-attribute-name="@hideVendorBlockAttributeName" asp-hide="@hideVendorBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Product/_ProductsMenuReport.Vendor.cshtml", Model)</nop-card>
                    }
                </nop-cards>
            }
            else
            {
                @T("Plugins.Reports.ChartsAndTables.Products.Menu.None")
            }
        </div>
    </div>
</section>
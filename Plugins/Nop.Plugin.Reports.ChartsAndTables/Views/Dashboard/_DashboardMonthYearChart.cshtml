@{
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/d3.v5.js", excludeFromBundle: true);

    const string prefix = "dashboardyearmonth-statistics";
    const string hideCardAttributeName = "HideDashboardYearMonthStatisticsPanel";
    var hideCard = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCardAttributeName);
}

<div class="card card-primary card-outline @if (hideCard){<text>collapsed-card</text>}" id="@(prefix)-card">
    <div class="card-header with-border">
        <h3 class="card-title">
            <i class="fas fa-chart-bar"></i>
            @T("Plugins.Reports.ChartsAndTables.Dashboard.DashboardYearMonthStatistics")
        </h3>
        <div class="card-tools float-right">
            <button class="btn btn-xs btn-info btn-flat" @if (hideCard) { <text> disabled="disabled" </text> } data-chart-role="toggle-chart" data-chart-period="refresh"><i class="fas fa-sync-alt" style="padding-left: 5px"></i></button>
            <button type="button" class="btn btn-tool margin-l-10" data-card-widget="collapse">
                @if (hideCard)
                {
                    <text><i class="fas fa-plus"></i></text>
                }
                else
                {
                    <text><i class="fas fa-minus"></i></text>
                }
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="chart" style="height: 400px;">
            <canvas id="@(prefix)-chart" height="400"></canvas>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var osCurrentPeriod;

        $('#@(prefix)-card').on('click', 'button[data-card-widget="collapse"]', function () {
            var collapsed = !$('#@(prefix)-card').hasClass('collapsed-card');
            saveUserPreferences('@(Url.Action("SavePreference", "Preferences"))', '@hideCardAttributeName', collapsed);

            if (!collapsed) {
                $('#@(prefix)-card button[data-chart-role="toggle-chart"]').removeAttr('disabled');
                if (!osCurrentPeriod) {
                    $('#@(prefix)-card button[data-chart-role="toggle-chart"][data-chart-period="refresh"]').trigger('click');
                }
            } else {
                $('#@(prefix)-card button[data-chart-role="toggle-chart"]').attr('disabled', 'disabled');
            }
        });

        var osConfig = nopChart.MultiBar('@T("Plugins.Reports.ChartsAndTables.Dashboard.DashboardYearMonthStatistics")');

        function changeOsPeriod(period) {
            var osLabels = getMonthNames("@((await workContext.GetWorkingLanguageAsync()).LanguageCulture)", "long");
            var osData = [];

            $.ajax({
                cache: false,
                type: "GET",
                url: "@Url.Action("LoadDashboardYearMonthStatistics", "ChartsAndTablesMenu")",
                success: function (data, textStatus, jqXHR) {
                    var expensesByName = d3.nest()
                        .key(function (d) { return d.Interval; })
                        .entries(data);

                    for (var i = 0; i < expensesByName.length; i++) {
                        var bcolour = colour("0.2");
                        var dataset = {
                            label: expensesByName[i].key,
                            backgroundColor: bcolour.withgrade,
                            borderColor: bcolour.withoutgrade,
                            borderWidth: 1,
                            data: []
                        };
                        for (var j = 0; j < expensesByName[i].values.length; j++) {
                            var month = expensesByName[i].values[j].Day.split('-');
                            var index = parseInt(month[1]) - 1;
                            dataset.data[index] = expensesByName[i].values[j].TotalSales;
                        }
                        osData.push(dataset);
                    }

                    if (!window.dashboardYearMonthStatistics) {
                        osConfig.data.labels = osLabels;
                        osConfig.data.datasets = osData;
                        osConfig.data.scales =
                            window.dashboardYearMonthStatistics = new Chart(document.getElementById("@prefix-chart").getContext("2d"), osConfig);
                    } else {
                        window.dashboardYearMonthStatistics.config.data.labels = osLabels;
                        window.dashboardYearMonthStatistics.config.data.datasets = osData;
                        window.dashboardYearMonthStatistics.update();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    $("#loadOrderStatisticsAlert").click();
                }
            });
        }

        $('#@(prefix)-card button[data-chart-role="toggle-chart"]').on('click', function () {
            var period = $(this).attr('data-chart-period');
            osCurrentPeriod = period;
            changeOsPeriod(period);
            $('#@(prefix)-card button[data-chart-role="toggle-chart"]').removeClass('bg-light-blue');
            $(this).addClass('bg-light-blue');
        });

        @if (!hideCard)
        {
            <text>
                $('#@(prefix)-card button[data-chart-role="toggle-chart"][data-chart-period="refresh"]').trigger('click');
            </text>
        }
    });
</script>
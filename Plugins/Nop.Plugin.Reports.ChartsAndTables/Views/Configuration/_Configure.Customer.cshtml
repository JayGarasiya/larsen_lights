            <div class="form-group row">
                <div class="col-md-3">
                    <nop-override-store-checkbox asp-for="CustomerTopNChart_OverrideForStore" asp-input="CustomerTopNChart" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                    <nop-label asp-for="CustomerTopNChart" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="CustomerTopNChart" />

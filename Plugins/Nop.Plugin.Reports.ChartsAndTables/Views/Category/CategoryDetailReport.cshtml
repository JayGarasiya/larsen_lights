@model ChartsAndTablesSearchModel
@{
    const string reportTabsBlockAttributeName = "CategoryPage.CategoryReport";
    var hideReportTabsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), reportTabsBlockAttributeName, defaultValue: true);

    if (Model.CategoryReport)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/chart.js/chart.umd.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/buttons.html5.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/report.chart.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/jszip.min.js", excludeFromBundle: true);
    }
}

@if (Model.CategoryReport && Model.CategoryId > 0)
{
    <nop-card asp-name="category-report-tabs" asp-icon="fa fa-chart-line" asp-title="@T("Admin.Reports")" asp-hide-block-attribute-name="@reportTabsBlockAttributeName" asp-hide="@hideReportTabsBlock" asp-advanced="false">
        <div class="card-body">
            <div class="card card-default">
                <div class="card-body">
                    <input asp-for="CategoryId" type="hidden" />
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="StartDate" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="StartDate" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="EndDate" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="EndDate" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchGroupId" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="SearchGroupId" asp-items="Model.GroupByOptions" />
                                </div>
                            </div>
                            <div class="form-group row" @(Model.IsLoggedInAsVendor ? Html.Raw("style='display: none;'") : null)>
                                <div class="col-md-4">
                                    <nop-label asp-for="OrderStatusId" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="OrderStatusId" asp-items="Model.AvailableOrderStatuses" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="PaymentStatusId" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group row" @(Model.AvailableStores.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                <div class="col-md-4">
                                    <nop-label asp-for="StoreId" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="ManufacturerId" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="ManufacturerId" asp-items="Model.AvailableManufacturers" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="VendorId" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="VendorId" asp-items="Model.AvailableVendors" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="text-center col-12">
                            <button type="button" id="btnGenerate" class="btn btn-primary btn-search">
                                <i class="fas fa-chart-line"></i>
                                @T("Plugins.Reports.ChartsAndTables.Generate")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <nop-tabs id="categoryreport-edit" asp-tab-name-to-select="tab-detail-category" asp-render-selected-tab-input="false">
                @if (Model.CategoryDetailCategoryReport)
                {
                    <nop-tab asp-name="tab-detail-category" asp-title="@T("Plugins.Reports.ChartsAndTables.Categories.Detail.Category")">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Category/_CategoryDetailReport.Category.cshtml", Model)</nop-tab>
                }
                @if (Model.CategoryDetailProductReport)
                {
                    <nop-tab asp-name="tab-detail-product" asp-title="@T("Plugins.Reports.ChartsAndTables.Categories.Detail.Product")">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Category/_CategoryDetailReport.Product.cshtml", Model)</nop-tab>
                }
                @if (Model.CategoryDetailManufacturerReport)
                {
                    <nop-tab asp-name="tab-detail-manufacturer" asp-title="@T("Plugins.Reports.ChartsAndTables.Categories.Detail.Manufacturer")">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Category/_CategoryDetailReport.Manufacturer.cshtml", Model)</nop-tab>
                }
                @if (Model.CategoryDetailVendorReport)
                {
                    <nop-tab asp-name="tab-detail-vendor" asp-title="@T("Plugins.Reports.ChartsAndTables.Categories.Detail.Vendor")">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Category/_CategoryDetailReport.Vendor.cshtml", Model)</nop-tab>
                }
                @if (Model.CategoryDetailShareCategoryReport)
                {
                    <nop-tab asp-name="tab-detail-share" asp-title="@T("Plugins.Reports.ChartsAndTables.Categories.Detail.CategoriesShare")">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Category/_CategoryDetailReport.CategoryShare.cshtml", Model)</nop-tab>
                }
            </nop-tabs>
        </div>
    </nop-card>
}
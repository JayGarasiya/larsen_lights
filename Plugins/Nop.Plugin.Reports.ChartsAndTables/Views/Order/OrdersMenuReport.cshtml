@model ChartsAndTablesSearchModel
@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugins.Reports.ChartsAndTables.Orders").Text;

    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Plugins.Reports.ChartsAndTables.Orders");

    if (Model.OrderReport)
    {
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/chart.js/chart.umd.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/buttons.html5.min.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/report.chart.js", excludeFromBundle: true);
        NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Reports.ChartsAndTables/Content/Js/jszip.min.js", excludeFromBundle: true);
    }
}

@{
    const string hideSearchBlockAttributeName = "ReportsOrderMenu.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    const string hideOrderBlockAttributeName = "ReportsOrderMenu.HideOrderBlock";
    var hideOrderBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideOrderBlockAttributeName);

    const string hideOrderItemBlockAttributeName = "ReportsOrderMenu.HideOrderItemBlock";
    var hideOrderItemBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideOrderItemBlockAttributeName, defaultValue: true);

    const string hideShippingMethodBlockAttributeName = "ReportsOrderMenu.HideShippigMethodBlock";
    var hideShippingMethodBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideShippingMethodBlockAttributeName, defaultValue: true);

    const string hidePaymentMethodBlockAttributeName = "ReportsOrderMenu.HidePaymentMethodBlock";
    var hidePaymentMethodBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hidePaymentMethodBlockAttributeName, defaultValue: true);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Reports.ChartsAndTables.Orders")
    </h1>
    <div class="float-right">
        &nbsp;
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            @if (Model.OrderReport)
            {
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>

                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="StartDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="StartDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="EndDate" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="EndDate" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchGroupId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="SearchGroupId" asp-items="Model.GroupByOptions" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="ShippingMethod" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="ShippingMethod" asp-items="Model.AvailableShippingMethods" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="PaymentMethod" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="PaymentMethod" asp-items="Model.AvailablePaymentMethods" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="form-group row" @(Model.AvailableStores.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="StoreId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" />
                                            </div>
                                        </div>
                                        <div class="form-group row" @(Model.IsLoggedInAsVendor? Html.Raw("style='display: none;'") : null)>
                                            <div class="col-md-4">
                                                <nop-label asp-for="OrderStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="OrderStatusId" asp-items="Model.AvailableOrderStatuses" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="PaymentStatusId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="PaymentStatusId" asp-items="Model.AvailablePaymentStatuses" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="CountryId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="CountryId" asp-items="Model.AvailableCountries" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="VendorId" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="VendorId" asp-items="Model.AvailableVendors" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="text-center col-12">
                                        <button type="button" id="btnGenerate" class="btn btn-primary btn-search">
                                            <i class="fas fa-chart-line"></i>
                                            @T("Plugins.Reports.ChartsAndTables.Generate")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <nop-cards id="reports-menu-orders-cards">
                    @if (Model.OrderMenuOrderReport)
                    {
                        <nop-card asp-name="orders-report" asp-icon="far fa-user" asp-title="@T("Plugins.Reports.ChartsAndTables.Orders.Menu.Order")" asp-hide-block-attribute-name="@hideOrderBlockAttributeName" asp-hide="@hideOrderBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Order/_OrdersMenuReport.Orders.cshtml", Model)</nop-card>
                    }
                    @if (Model.OrderMenuOrderItemReport)
                    {
                        <nop-card asp-name="order-item-report" asp-icon="far fa-registered" asp-title="@T("Plugins.Reports.ChartsAndTables.Orders.Menu.OrderItem")" asp-hide-block-attribute-name="@hideOrderItemBlockAttributeName" asp-hide="@hideOrderItemBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Order/_OrdersMenuReport.OrderItem.cshtml", Model)</nop-card>
                    }
                    @if (Model.OrderMenuShippingMethodReport)
                    {
                        <nop-card asp-name="shipping-method-report" asp-icon="fas fa-mars-double" asp-title="@T("Plugins.Reports.ChartsAndTables.Orders.Menu.ShippingMethod")" asp-hide-block-attribute-name="@hideShippingMethodBlockAttributeName" asp-hide="@hideShippingMethodBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Order/_OrdersMenuReport.ShippingMethod.cshtml", Model)</nop-card>
                    }
                    @if (Model.OrderMenuPaymentMethodReport)
                    {
                        <nop-card asp-name="payment-method-report" asp-icon="fas fa-code-branch" asp-title="@T("Plugins.Reports.ChartsAndTables.Orders.Menu.PaymentMethod")" asp-hide-block-attribute-name="@hidePaymentMethodBlockAttributeName" asp-hide="@hidePaymentMethodBlock" asp-advanced="false">@await Html.PartialAsync("~/Plugins/Reports.ChartsAndTables/Views/Order/_OrdersMenuReport.PaymentMethod.cshtml", Model)</nop-card>
                    }
                </nop-cards>
            }
            else
            {
                @T("Plugins.Reports.ChartsAndTables.Orders.Menu.None")
            }
        </div>
    </div>
</section>
@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";

    NopHtml.SetActiveMenuItemSystemName("Nop.Plugin.Misc.Inventory.Order.Configuration");
}

<form asp-controller="InventoryOrder" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AllowedManufacturers" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="AllowedManufacturers" asp-items="Model.AvailableManufacturers" asp-multiple="true" />
                        <span asp-validation-for="AllowedManufacturers"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <input type="submit" name="save" class="btn btn-primary" value="@T("Admin.Common.Save")" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
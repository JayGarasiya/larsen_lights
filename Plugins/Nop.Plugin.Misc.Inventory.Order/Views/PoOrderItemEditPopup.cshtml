@model PoOrderItemModel

@{
    Layout = "_AdminPopupLayout";
    ViewBag.PageTitle = T("Plugins.InventoryOrder.OrderQty.PoOrderItem.Edit").Text;
    var childId = Context.Request.Query["id"].ToString() ?? "0";
}

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

@if (ViewBag.RefreshPage == true)
{
    <script>
        try { window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click(); }
        catch (e) {

        }
        window.close();
    </script>
}
<form asp-controller="InventoryOrder" asp-action="PoOrderItemEditPopup"
      asp-route-id="@childId"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <section class="content">
        <div class="container-fluid">
            <div class="content-header clearfix">
                <h1 class="float-left">
                    @T("Plugins.InventoryOrder.Fields.Edit")
                </h1>
                <div class="float-right">
                    <button type="submit" name="save" id="PoOrderItemSave" class="btn btn-primary">
                        <i class="far fa-save"></i>
                        @T("Admin.Common.Save")
                    </button>
                    <button type="submit" id="btnRefreshPoOrderItem" style="display: none"></button>
                </div>
            </div>
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-popup">
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="OrderedQty" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="OrderedQty" />
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
<script>
    $(document).ready(function () {
        $('#PoOrderItemSave').click(function () {
            var orderedQty = $("#@Html.IdFor(model => model.OrderedQty)").val();
            var postData = {
                orderedQty: orderedQty,
                id: '@Model.Id'
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("PoOrderitemUpdate", "InventoryOrder"))",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    if (data.Result) {
                        alert("Product Dimension is Save Successfully.");
                    }
                    else {
                        alert(data.message);
                    }
                },
            });
        });
    });
</script>
